local function detect()
    local forced = nil
    pcall(function() forced = getgenv and getgenv().BeeForce or nil end)
    if type(forced) == "string" and forced ~= "" then
        for _, m in ipairs(META) do
            if m.id == forced then return m, "forced (" .. forced .. ")" end
        end
        print("[BeeBundle] unknown BeeForce id: " .. tostring(forced))
    end
    local uni = game.GameId
    for _, m in ipairs(META) do
        if m.universe == uni then return m, "universe " .. tostring(uni) end
    end
    local pid = game.PlaceId
    for _, m in ipairs(META) do
        if m.places[pid] then return m, "place " .. tostring(pid) end
    end
    for _, m in ipairs(META) do
        local ok, hit = pcall(m.sig)
        if ok and hit then return m, "game vars (" .. m.id .. ")" end
    end
    return nil, "universe " .. tostring(uni) .. " / place " .. tostring(pid)
end

