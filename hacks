-- The submit remote renames itself, so steal the live reference out of
-- the game's own FocusLost closure (it holds the TextBox + the remote).
local typingRemote = nil
local function getTypingRemote()
    if typingRemote and typingRemote.Parent then return typingRemote end
    local direct = RS:FindFirstChild("TypingEvent")
    if direct and direct:IsA("BaseRemoteEvent") then
        typingRemote = direct
        return typingRemote
    end
    pcall(function()
        local tb = textbox()
        if not tb then return end
        for _, fn in ipairs(filtergc("function", { Upvalues = { tb } }, false)) do
            for _, v in ipairs(debug.getupvalues(fn)) do
                if typeof(v) == "Instance" and v:IsA("BaseRemoteEvent") then
                    typingRemote = v
                    return
                end
            end
            if typingRemote then return end
        end
    end)
    return typingRemote
end

-- Emitter for visible typing. Aborts (returns false) on panic OR as
-- soon as the turn is lost, so typing never overruns into someone
-- else's turn.
local function emitWord(word, emitFrag)
    local n = #word
    if n == 0 then return true end
    if cps <= 0 then
        -- INSTANT PASTE: fresh word, zero delays
        local fresh = currentWord()
        if fresh ~= "" then word = fresh end
        emitFrag(word)
        return not panicStop and guiOpen()
    end
    if cps <= BATCH_THRESHOLD then
        local i, b = 1, 0
        while i <= n do
            if panicStop or not guiOpen() then return false end
            if typosOn and i > 1 and i < n and math.random(100) <= typoRate then
                local ch = word:sub(i, i)
                local wrong = string.char(math.random(97, 122))
                if wrong == ch then wrong = "x" end
                emitFrag(word:sub(1, i - 1) .. wrong)
                task.wait(charDelay() + 0.15 + math.random() * 0.3)
                emitFrag(word:sub(1, i - 1))
                task.wait(0.12 + math.random() * 0.2)
            end
            emitFrag(word:sub(1, i))
            i = i + 1
            b = b + 1
            task.wait(charDelay())
            if burstOn and b >= burstN and i <= n then
                b = 0
                burstPause()
            end
        end
        return not panicStop and guiOpen()
    end
    local spent, sent, b = 0, 0, 0
    while sent < n do
        if panicStop or not guiOpen() then return false end
        local dt = RunService.Heartbeat:Wait()
        spent = spent + dt
        if jitterOn and math.random() < 0.06 then
            spent = math.max(0, spent - (0.4 + math.random() * 0.4))
        end
        local want = math.min(n, math.floor(spent * cps) + 1)
        if want > sent then
            if typosOn and want > 1 and want < n and math.random(100) <= typoRate then
                local ch = word:sub(want, want)
                local wrong = string.char(math.random(97, 122))
                if wrong == ch then wrong = "x" end
                emitFrag(word:sub(1, want - 1) .. wrong)
                task.wait(0.12 + math.random() * 0.2)
            end
            local prev = sent
            sent = want
            emitFrag(word:sub(1, sent))
            b = b + (sent - prev)
            if burstOn and b >= burstN and sent < n then
                b = 0
                burstPause()
            end
        end
    end
    return not panicStop and guiOpen()
end

-- Search every *Words module (ALLWords, NORMALWords, ...) and both
-- entry shapes: {word, id, def} and {word, id, extra, def}.
local WordsCaches = nil
local function wordModules()
    if WordsCaches then return WordsCaches end
    WordsCaches = {}
    for _, m in ipairs(RS:GetChildren()) do
        if m:IsA("ModuleScript") and m.Name:match("Words$") then
            local ok, mod = pcall(require, m)
            if ok and type(mod) == "table" then
                table.insert(WordsCaches, mod)
            end
        end
    end
    return WordsCaches
end
local function entryMatches(e, def)
    if type(e) ~= "table" then return nil end
    if e[3] == def or e[4] == def then return e[1] end
    return nil
end
local function findWordByDefinition(def)
    if not def or def == "" then return nil end
    for _, mod in ipairs(wordModules()) do
        for _, e in pairs(mod) do
            if type(e) == "table" then
                local hit = entryMatches(e, def)
                if hit then return hit end
                -- One level of categories, e.g. { Unreal = { {...}, ... } }.
                if type(e[1]) == "table" then
                    for _, sub in ipairs(e) do
                        local shit = entryMatches(sub, def)
                        if shit then return shit end
                    end
                end
            end
        end
    end
    return nil
end

local function noteWord(w, src)
    lastWord = w
    lastWordAt = os.clock()
    rounds = rounds + 1
    if roundsStat then pcall(function() roundsStat:Set(rounds) end) end
    if wordBox then pcall(function() wordBox:Set(w .. "  (" .. #w .. " letters)" .. (src and (" [" .. src .. "]") or "")) end) end
    table.insert(history, w)
    if #history > 30 then table.remove(history, 1) end
    if historyBox then pcall(function() historyBox:Append(rounds .. ". " .. w) end) end
    if autoCopy then copyToClipboard(w, false) end
end
local function noteAdmin(payload)
    adminWord = payload
    adminSeen = adminSeen + 1
    if adminStat then pcall(function() adminStat:Set(adminSeen) end) end
    if adminBox then pcall(function() adminBox:Set(payload:sub(1, 80)) end) end
    say("ADMIN WORD: " .. payload:sub(1, 60))
    window:Notify({ title = "Admin word", content = payload:sub(1, 80) })
end
local function logTyping(w, mode, secs)
    if typingBox then pcall(function()
        typingBox:Append(w:sub(1, 30) .. " [" .. mode .. ", " .. string.format("%.1f", secs) .. "s]")
    end) end
    local mins = math.max(secs / 60, 1 / 3600)
    curWpm = math.floor((#w / 5) / mins + 0.5)
    if curWpmStat then pcall(function() curWpmStat:Set(curWpm) end) end
    if curWpm > bestWpm then
        bestWpm = curWpm
        if bestStat then pcall(function() bestStat:Set(bestWpm) end) end
    end
end
local function submitAnswer(box, text)
    if not guiOpen() then
        say("Turn lost before submit - skipped (no late submit).")
        return
    end
    if not directSubmit and box then
        local ok = pcall(function() box:ReleaseFocus(true) end)
        if ok then
            say("Submitted via Enter (game's own path).")
            return
        end
    end
    local rem = getTypingRemote() or RS:FindFirstChild("SubmitAnswer")
    if rem then pcall(function() (rem :: any):FireServer(text, true) end) end
    say("Submitted via remote.")
end

-- Ghost mode: pure invisible submit through the stolen remote ref. The
-- box is never touched - nothing to see, locally or otherwise. This
-- game has no per-keystroke typing channel (submit-only), so ghost is
-- a single direct submit after the start delay.
local function ghostType(word)
    say("Ghost: resolving remote...")
    local rem = getTypingRemote()
    if not rem then
        say("Ghost FAIL: submit remote not found (feed line G1).")
        return
    end
    say("Ghost: remote ok. waiting delay...")
    if cps > 0 then task.wait(preDelayCs / 100) end
    if panicStop then
        say("Ghost: panic stopped.")
        return
    end
    if not guiOpen() then
        say("Ghost: not your turn anymore - skipped.")
        return
    end
    local ok = pcall(function() (rem :: any):FireServer(word, true) end)
    say(ok and "Ghost: submit FIRED, waiting result..." or "Ghost FAIL: FireServer errored (feed line G2).")
    if cps > 0 then task.wait(submitDelayCs / 100) end
end

local function typeWord(word)
    if typing then return end
    syncCps()
    if maxLen > 0 and #word > maxLen then
        say("Skipped: " .. #word .. " letters over limit.")
        return
    end
    if focusPause and isFocused() == false then
        say("Paused: window not focused.")
        return
    end
    if not paperVisible() then
        say("Not your turn - holding.")
        return
    end
    typing = true
    panicStop = false
    local t0 = os.clock()
    if ghostMode then
        ghostType(word)
        typeTimeTotal = typeTimeTotal + (os.clock() - t0)
        lettersTotal = lettersTotal + #word
        if lettersStat then pcall(function() lettersStat:Set(lettersTotal) end) end
        logTyping(word, "ghost", os.clock() - t0)
        typing = false
        return
    end
    local box = textbox()
    if not box then
        say("No textbox found.")
        typing = false
        return
    end
    pcall(function() box:CaptureFocus() end)
    box.Text = ""
    if cps > 0 then task.wait(preDelayCs / 100) end
    if not guiOpen() then
        say("Turn lost during pre-delay - stopped.")
        typing = false
        return
    end
    if cps <= 0 then say("PASTE MODE - ban risk accepted.") end
    local ok = emitWord(word, function(frag)
        box.Text = frag
    end)
    if not ok then
        say("Stopped: turn lost mid-word (no late submit).")
        typing = false
        return
    end
    lettersTotal = lettersTotal + #word
    if lettersStat then pcall(function() lettersStat:Set(lettersTotal) end) end
    typeTimeTotal = typeTimeTotal + (os.clock() - t0)
    logTyping(word, (cps <= 0 and "paste" or ("visual@" .. cps .. "cps")), os.clock() - t0)
    if cps > 0 then task.wait(submitDelayCs / 100) end
    submitAnswer(box, box.Text)
    typing = false
end

