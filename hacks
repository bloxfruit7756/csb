]],
    labyrinth = [[--!nonstrict
-- Spelling Labyrinth Bee (Carl-inspired) -- Rayfield Gen2 edition
-- Game: Spelling Labyrinth (place 70727521984327)
-- 50 features: Speller / Round / Utility / Safety tabs.
-- Human preset types like a person; Macro preset types like a macro.
-- Ghost mode is pure invisible: submits without ever touching the box.
-- (Ghost mirror removed per request.)
-- Answer source: SpeakWord / AnnounceWordEvent / RepeatWordAudioEvent
-- all carry the word as arg 1 (it gets played as audio). Hooked all three.
-- Turn flow: "YourTurn" -> ~15s audio phase -> input box appears.
-- Gate is strict off SpellingInputBox.Visible (the game's own signal).
-- Submit: SubmitAnswerEvent(Text). No rename tricks in this game.
-- Typing traffic: UpdateTypingEvent per keystroke (game-driven in
-- visual; ghost fires it progressively itself).

local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer

local Rayfield = loadstring(game:HttpGet("https://sirius.menu/gen2"))()

local window = Rayfield:CreateWindow({
    name = "Spelling Labyrinth Bee",
    subtitle = "Rayfield Gen2 | 50 features",
    sidebarLayout = true,
})

local TabSpell = window:CreateTab({ name = "Speller" })
local TabRound = window:CreateTab({ name = "Round" })
local TabUtil = window:CreateTab({ name = "Utility" })
local TabSafe = window:CreateTab({ name = "Safety" })

-- ================= STATE =================
local autoOn = false
local cps = 7
local burstOn = true
local burstN = 5
local burstPauseCs = 30
local preDelayCs = 30
local submitDelayCs = 30
local typoRate = 5
local jitterOn = true
local typosOn = true
local ghostMode = false
local directSubmit = false
local autoShowAnswer = false
local autoFocus = false
local focusPause = false
local autoSlow = false
local antiAfk = false
local ignoreGate = false
local autoCopy = false
local panicOnModTag = true
local lastWord = ""
local lastWordAt = 0
local heardWords = 0
local submits = 0
local attempted = ""
local wasVisible = false
local typing = false
local panicStop = false
local maxLen = 0
local rounds, lettersTotal, typeTimeTotal, bestWpm, curWpm = 0, 0, 0, 0, 0
local startTime = os.clock()
local history = {}

-- Above this CPS, per-char task.wait() can't keep up (it can't sleep
-- less than one frame), so we emit batched chunks per frame instead.
local BATCH_THRESHOLD = 40

-- UI handles (forward-declared so engine code can use them)
local log, wordBox, historyBox, typingBox = nil, nil, nil, nil
local roundsStat, lettersStat, bestStat, curWpmStat, uptimeStat = nil, nil, nil, nil, nil
local avgStat, heardStat, submitStat = nil, nil, nil
local cpsInput = nil
local autoToggle = nil

-- FPS sampler for auto-slow
local fpsAvg = 60
pcall(function()
    local acc, n = 0, 0
    RunService.RenderStepped:Connect(function(dt)
        acc = acc + dt
        n = n + 1
        if n >= 30 then
            fpsAvg = n / math.max(acc, 0.001)
            acc, n = 0, 0
        end
    end)
end)

-- ================= HELPERS (Labyrinth mapping) =================
local function inputBox()
    local g = LocalPlayer.PlayerGui:FindFirstChild("SpellingBeeGui")
    local box = g and g:FindFirstChild("SpellingInputBox")
    if box and box:IsA("TextBox") then return box end
    return nil
end
-- Strict turn gate: the game shows the input box ONLY on your turn
-- (after the audio phase). Trust that, nothing else.
local function guiOpen()
    local box = inputBox()
    return box ~= nil and box.Visible == true
end
local function paperVisible()
    if ignoreGate then return true end
    return guiOpen()
end
local function currentWord()
    return lastWord
end
local function slowMult()
    if autoSlow and fpsAvg < 20 then return 1.6 end
    return 1
end
local function charDelay()
    if cps <= 0 then return 0 end
    local base = 1 / cps * slowMult()
    if not jitterOn then return base end
    local d = base + math.random() * base
    if math.random() < 0.06 then d = d + 0.4 + math.random() * 0.4 end
    return d
end
local function burstPause()
    local p = burstPauseCs / 100 * slowMult()
    if jitterOn then p = p + math.random() * (burstPauseCs / 100) end
    task.wait(p)
end
local function isFocused()
    local f = nil
    pcall(function()
        local g = getgenv and getgenv() or _G
        local fn = (g and (g :: any).isrbxactive) or ((getfenv() :: any).isrbxactive)
        if type(fn) == "function" then f = fn() end
    end)
    return f
end
local function syncCps()
    if not cpsInput then return end
    pcall(function()
        local t = tonumber(cpsInput.value)
        if t then cps = math.clamp(math.floor(t), 0, 1000) end
    end)
end
local function say(m)
    if log then pcall(function() log:Append(m) end) end
end
local function copyToClipboard(w, announce)
    if not w or w == "" then
        if announce then say("No active word.") end
        return false
    end
    local done = false
    pcall(function()
        if type(setclipboard) == "function" then
            setclipboard(w)
            done = true
        end
    end)
    if announce then say(done and "Copied: " .. w:sub(1, 40) or "Clipboard unavailable.") end
    return done
end
local function fireTyping(text)
    local rem = RS:FindFirstChild("UpdateTypingEvent")
    if rem then pcall(function() (rem :: any):FireServer(text) end) end
end

-- Typing emitter. emitFrag applies one step (box text and/or manual
-- typing traffic). Aborts on panic or the instant the turn is lost.
local function emitWord(word, emitFrag)
    local n = #word
    if n == 0 then return true end
    if cps <= 0 then
        -- INSTANT PASTE: fresh word, zero delays
        local fresh = currentWord()
        if fresh ~= "" then word = fresh end
        emitFrag(word)
        return not panicStop and guiOpen()
    end
    if cps <= BATCH_THRESHOLD then
        local i, b = 1, 0
        while i <= n do
            if panicStop or not guiOpen() then return false end
            if typosOn and i > 1 and i < n and math.random(100) <= typoRate then
                local ch = word:sub(i, i)
                local wrong = string.char(math.random(97, 122))
                if wrong == ch then wrong = "x" end
                emitFrag(word:sub(1, i - 1) .. wrong)
                task.wait(charDelay() + 0.15 + math.random() * 0.3)
                emitFrag(word:sub(1, i - 1))
                task.wait(0.12 + math.random() * 0.2)
            end
            emitFrag(word:sub(1, i))
            i = i + 1
            b = b + 1
            task.wait(charDelay())
            if burstOn and b >= burstN and i <= n then
                b = 0
                burstPause()
            end
        end
        return not panicStop and guiOpen()
    end
    local spent, sent, b = 0, 0, 0
    while sent < n do
        if panicStop or not guiOpen() then return false end
        local dt = RunService.Heartbeat:Wait()
        spent = spent + dt
        if jitterOn and math.random() < 0.06 then
            spent = math.max(0, spent - (0.4 + math.random() * 0.4))
        end
        local want = math.min(n, math.floor(spent * cps) + 1)
        if want > sent then
            if typosOn and want > 1 and want < n and math.random(100) <= typoRate then
                local ch = word:sub(want, want)
                local wrong = string.char(math.random(97, 122))
                if wrong == ch then wrong = "x" end
                emitFrag(word:sub(1, want - 1) .. wrong)
                task.wait(0.12 + math.random() * 0.2)
            end
            local prev = sent
            sent = want
            emitFrag(word:sub(1, sent))
            b = b + (sent - prev)
            if burstOn and b >= burstN and sent < n then
                b = 0
                burstPause()
            end
        end
    end
    return not panicStop and guiOpen()
end

local function noteWord(w, src)
    lastWord = w
    lastWordAt = os.clock()
    heardWords = heardWords + 1
    rounds = rounds + 1
    if roundsStat then pcall(function() roundsStat:Set(rounds) end) end
    if heardStat then pcall(function() heardStat:Set(heardWords) end) end
    if wordBox then pcall(function() wordBox:Set(w .. "  (" .. #w .. " letters)" .. (src and (" [" .. src .. "]") or "")) end) end
    table.insert(history, w)
    if #history > 30 then table.remove(history, 1) end
    if historyBox then pcall(function() historyBox:Append(rounds .. ". " .. w) end) end
    if autoCopy then copyToClipboard(w, false) end
end
local function logTyping(w, mode, secs)
    if typingBox then pcall(function()
        typingBox:Append(w:sub(1, 30) .. " [" .. mode .. ", " .. string.format("%.1f", secs) .. "s]")
    end) end
    local mins = math.max(secs / 60, 1 / 3600)
    curWpm = math.floor((#w / 5) / mins + 0.5)
    if curWpmStat then pcall(function() curWpmStat:Set(curWpm) end) end
    if curWpm > bestWpm then
        bestWpm = curWpm
        if bestStat then pcall(function() bestStat:Set(bestWpm) end) end
    end
end
local function submitAnswer(box, text)
    if not guiOpen() then
        say("Turn lost before submit - skipped (no late submit).")
        return
    end
    if not directSubmit and box then
        local ok = pcall(function() box:ReleaseFocus(true) end)
        if ok then
            submits = submits + 1
            if submitStat then pcall(function() submitStat:Set(submits) end) end
            say("Submitted via Enter (game's own path).")
            return
        end
    end
    local rem = RS:FindFirstChild("SubmitAnswerEvent")
    if rem then pcall(function() (rem :: any):FireServer(text) end) end
    submits = submits + 1
    if submitStat then pcall(function() submitStat:Set(submits) end) end
    say("Submitted via remote.")
end

-- Ghost mode: pure invisible. The box is never touched. Typing traffic
-- still goes out progressively (human cadence) so the server-side
-- moderation sees a typist, not a teleporter.
local function ghostType(word)
    say("Ghost: waiting delay...")
    if cps > 0 then task.wait(preDelayCs / 100) end
    if panicStop then
        say("Ghost: panic stopped.")
        return
    end
    if not guiOpen() then
        say("Ghost: not your turn anymore - skipped.")
        return
    end
    local ok = emitWord(word, function(frag)
        fireTyping(frag)
    end)
    if not ok then
        say("Ghost: turn lost mid-word - skipped submit.")
        return
    end
    if not guiOpen() then
        say("Ghost: turn lost before submit - skipped.")
        return
    end
    local rem = RS:FindFirstChild("SubmitAnswerEvent")
    if rem then pcall(function() (rem :: any):FireServer(word) end) end
    submits = submits + 1
    if submitStat then pcall(function() submitStat:Set(submits) end) end
    say("Ghost: submit FIRED, waiting result...")
    if cps > 0 then task.wait(submitDelayCs / 100) end
end

local function typeWord(word)
    if typing then return end
    syncCps()
    if maxLen > 0 and #word > maxLen then
        say("Skipped: " .. #word .. " letters over limit.")
        return
    end
    if focusPause and isFocused() == false then
        say("Paused: window not focused.")
        return
    end
    if not paperVisible() then
        say("Not your turn - holding.")
        return
    end
    typing = true
    panicStop = false
    local t0 = os.clock()
    if ghostMode then
        ghostType(word)
        typeTimeTotal = typeTimeTotal + (os.clock() - t0)
        lettersTotal = lettersTotal + #word
        if lettersStat then pcall(function() lettersStat:Set(lettersTotal) end) end
        logTyping(word, "ghost", os.clock() - t0)
        typing = false
        return
    end
    local box = inputBox()
    if not box then
        say("No textbox found.")
        typing = false
        return
    end
    pcall(function() box:CaptureFocus() end)
    box.Text = ""
    if cps > 0 then task.wait(preDelayCs / 100) end
    if not guiOpen() then
        say("Turn lost during pre-delay - stopped.")
        typing = false
        return
    end
    if cps <= 0 then say("PASTE MODE - ban risk accepted.") end
    local ok = emitWord(word, function(frag)
        box.Text = frag
    end)
    if not ok then
        say("Stopped: turn lost mid-word (no late submit).")
        typing = false
        return
    end
    lettersTotal = lettersTotal + #word
    if lettersStat then pcall(function() lettersStat:Set(lettersTotal) end) end
    typeTimeTotal = typeTimeTotal + (os.clock() - t0)
    logTyping(word, (cps <= 0 and "paste" or ("visual@" .. cps .. "cps")), os.clock() - t0)
    if cps > 0 then task.wait(submitDelayCs / 100) end
    submitAnswer(box, box.Text)
    typing = false
end

