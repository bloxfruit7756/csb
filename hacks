local autoToggle = TabSpell:CreateToggle({ name = "Auto-spell", description = "Types the round word on your turn", value = false, forgetState = true, callback = function(v)
    autoOn = v
    if v then
        say("Auto-spell ON. Keep the Roblox window focused.")
        task.spawn(function()
            while autoOn do
                local w = currentWord()
                local mine = paperVisible()
                if not mine then
                    turnActive = false
                    typedThisTurn = false
                elseif not typing then
                    if not turnActive then
                        turnActive = true
                        typedThisTurn = false
                    end
                    if w ~= "" and (not typedThisTurn or w ~= lastWord) then
                        noteWord(w)
                        typeWord(w:lower())
                        local lw = RS:FindFirstChild("LastWPM")
                        if lw and lw.Value > bestWpm then
                            bestWpm = math.floor(lw.Value)
                            if bestStat then pcall(function() bestStat:Set(bestWpm) end) end
                        end
                    end
                end
                if uptimeStat then pcall(function() uptimeStat:Set(math.floor(os.clock() - startTime)) end) end
                local lw2 = RS:FindFirstChild("LastWPM")
                if lw2 and curWpmStat then pcall(function() curWpmStat:Set(math.floor(lw2.Value)) end) end
                if avgStat then
                    local a = typeTimeTotal > 0 and math.floor(lettersTotal / typeTimeTotal + 0.5) or 0
                    pcall(function() avgStat:Set(a) end)
                end
                local rw = RS:FindFirstChild("RoundWords")
                if rw and rwStat then pcall(function() rwStat:Set(rw.Value) end) end
                local df = RS:FindFirstChild("CurrentDifficulty")
                if df and diffStat then pcall(function() diffStat:Set(tonumber(df.Value) or 0) end) end
                if autoFocus and paperVisible() then
                    local bx = textbox()
                    if bx then pcall(function()
                        if not bx:IsFocused() then bx:CaptureFocus() end
                    end) end
                end
                task.wait(0.4)
            end
        end)
    else
        say("Auto-spell OFF.")
    end
end })
