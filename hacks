-- 50 features: Speller / Round / Utility / Safety tabs.
-- Word = ReplicatedStorage.WordThing | Box = PlayerGui.SpellingGui.TextBox | Turn = SpellingGui.Enabled
-- Submit = game's own FocusLost->CheckWord via Enter. Type mirror = SpellingBeeSystem.TypeUpdate. Repeat = RepeatWord.

local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")
local LocalPlayer = Players.LocalPlayer

local Rayfield = loadstring(game:HttpGet("https://sirius.menu/gen2"))()

local window = Rayfield:CreateWindow({
    name = "Karls Spelling Bee AutoTyper",
    subtitle = "Rayfield Gen2",
    sidebarLayout = true,
})

local TabSpell = window:CreateTab({ name = "Speller" })
local TabRound = window:CreateTab({ name = "Round" })
local TabUtil = window:CreateTab({ name = "Utility" })
local TabSafe = window:CreateTab({ name = "Safety" })

-- ================= STATE =================
local autoOn = false
local cps = 7
local burstOn = true
local burstN = 5
local burstPauseCs = 30
local preDelayCs = 30
local submitDelayCs = 30
local typoRate = 5
local jitterOn = true
local typosOn = true
local ghostMode = false
local remoteSubmit = false
local autoRepeat = false
local autoFocus = false
local focusPause = false
local autoSlow = false
local antiAfk = false
local autoCopy = false
local turnActive = false
local typedThisTurn = false
local potato = false
local lastWord = ""
local typing = false
local panicStop = false
local maxLen = 0
local rounds, lettersTotal, typeTimeTotal, bestWpm = 0, 0, 0, 0
local startTime = os.clock()
local history = {}

local log, wordBox, historyBox, typingBox = nil, nil, nil, nil
local roundsStat, lettersStat, bestStat, curWpmStat, uptimeStat = nil, nil, nil, nil, nil
local avgStat, rwStat, diffStat = nil, nil, nil
local cpsInput = nil

local fpsAvg = 60
pcall(function()
    local acc, n = 0, 0
    game:GetService("RunService").RenderStepped:Connect(function(dt)
        acc = acc + dt
        n = n + 1
        if n >= 30 then fpsAvg = n / math.max(acc, 0.001) acc, n = 0, 0 end
    end)
end)

-- ================= GAME BINDINGS (Karl's) =================
local SBS = RS:WaitForChild("SpellingBeeSystem")
local TypeUpdate = SBS:WaitForChild("TypeUpdate")
local CheckWord = SBS:WaitForChild("CheckWord")
local RepeatRemote = SBS:WaitForChild("RepeatWord")
local WordThing = RS:WaitForChild("WordThing")

local function spellingGui()
    local pg = LocalPlayer:FindFirstChildOfClass("PlayerGui")
    return pg and pg:FindFirstChild("SpellingGui") or nil
end

-- ================= HELPERS =================
local function char() return LocalPlayer.Character end
local function say(m)
    if log then pcall(function() log:Append(m) end) end
end
local function textbox()
    local sg = spellingGui()
    local box = sg and sg:FindFirstChild("TextBox")
    if box and box:IsA("TextBox") then return box end
    return nil
end
local function paperVisible()
    local sg = spellingGui()
    return sg and sg.Enabled == true
end
local function isMyTurn()
    return paperVisible()
end
local function currentWord()
    local ok, v = pcall(function() return WordThing.Value end)
    if ok and type(v) == "string" then return v end
    return ""
end
local function difficultyNum()
    local ok, dv = pcall(function() return SBS:WaitForChild("DifficultyValue").Value end)
    if ok and type(dv) == "number" then return dv end
    return 0
end
local function slowMult()
    if autoSlow and fpsAvg < 20 then return 1.6 end
    return 1
end
local function charDelay()
    if cps <= 0 then return 0 end
    local base = 1 / cps * slowMult()
    if not jitterOn then return base end
    local d = base + math.random() * base
    if math.random() < 0.06 then d = d + 0.4 + math.random() * 0.4 end
    return d
end
local function isFocused()
    local f = nil
    pcall(function() f = isrbxactive() end)
    if f == nil then pcall(function() f = isgameactive() end) end
    return f
end
local function syncCps()
    if not cpsInput then return end
    pcall(function()
        local t = tonumber(cpsInput.value)
        if t then cps = math.clamp(math.floor(t), 0, 1000) end
    end)
end
local function mirrorType(txt)
    pcall(function() TypeUpdate:FireServer(txt) end)
end
local function noteWord(w)
    lastWord = w
    typedThisTurn = true
    rounds = rounds + 1
    if roundsStat then pcall(function() roundsStat:Set(rounds) end) end
    if rwStat then pcall(function() rwStat:Set(rounds) end) end
    if wordBox then pcall(function() wordBox:Set(w .. "  (" .. #w .. " letters)") end) end
    table.insert(history, w)
    if #history > 30 then table.remove(history, 1) end
    if historyBox then pcall(function() historyBox:Append(rounds .. ". " .. w) end) end
    if diffStat then pcall(function() diffStat:Set(difficultyNum()) end) end
    if autoCopy and w ~= "" then
        pcall(function()
            if type(setclipboard) == "function" then setclipboard(w) end
        end)
    end
    if autoRepeat then task.spawn(function() repeatAudio() end) end
end
local function logTyping(w, mode, secs)
    if typingBox then pcall(function()
        typingBox:Append(w .. " [" .. mode .. ", " .. string.format("%.1f", secs) .. "s]")
    end) end
    if secs > 0 then
        local wpm = math.floor((#w / math.max(secs, 0.01)) * 12 + 0.5)
        if curWpmStat then pcall(function() curWpmStat:Set(wpm) end) end
