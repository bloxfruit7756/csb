-- Bee Bundle: all 8 spelling-bee autotypers in one file.
-- Usage: loadstring(game:HttpGet("PUT-YOUR-RAW-URL-HERE"))()
-- Picks by UniverseId, then PlaceId, then game-var signatures. No GUI.
-- Override: getgenv().BeeForce = "carls" | "cups" | "xister" | "openw" | "labyrinth" | "karls" | "timmys" | "nerdzone"

local RS = game:GetService("ReplicatedStorage")

local function child(inst, name)
    if not inst then return nil end
    local ok, r = pcall(function() return inst:FindFirstChild(name) end)
    if ok then return r end
    return nil
end
local function hasPath(...)
    local node = RS
    for _, name in ipairs({ ... }) do
        node = child(node, name)
        if not node then return false end
    end
    return true
end

local S = {
    carls = [[-- Carl's Auto Speller v3 -- Rayfield Gen2 edition
-- 50 features: Speller / Round / Utility / Safety tabs.
-- Human profile types like a person; Macro profile types like a macro.
-- Ghost mode never touches the textbox (local checks see nothing).
-- CPS 0 = instant paste (paste-ban bait). Real rate caps at your FPS.

