local cps = 7
local burstOn = true
local burstN = 5
local burstPauseCs = 30
local preDelayCs = 30
local submitDelayCs = 30
local typoRate = 5
local jitterOn = true
local typosOn = true
local ghostMode = false
local remoteSubmit = false
local autoRepeat = false
local autoFocus = false
local focusPause = false
local autoSlow = false
local antiAfk = false
local autoCopy = false
local turnActive = false
local typedThisTurn = false
local potato = false
local lastWord = ""
local lastCat = ""
local typing = false
local panicStop = false
local maxLen = 0
local rounds, lettersTotal, typeTimeTotal, bestWpm = 0, 0, 0, 0
local startTime = os.clock()
local history = {}

local log, wordBox, historyBox, typingBox = nil, nil, nil, nil
local roundsStat, lettersStat, bestStat, curWpmStat, uptimeStat = nil, nil, nil, nil, nil
local avgStat, rwStat, diffStat = nil, nil, nil
local cpsInput = nil

local fpsAvg = 60
pcall(function()
    local acc, n = 0, 0
    game:GetService("RunService").RenderStepped:Connect(function(dt)
        acc = acc + dt
        n = n + 1
        if n >= 30 then fpsAvg = n / math.max(acc, 0.001) acc, n = 0, 0 end
    end)
end)

-- ================= GAME BINDINGS (Openw) =================
local UpdateBoard = RS:WaitForChild("UpdateBoardText")
local SubmitRemote = RS:WaitForChild("SubmitAnswer")
local RepeatRemote = RS:WaitForChild("RepeatWord")

local WordDB = nil
pcall(function() WordDB = require(RS:WaitForChild("DifficultyWords")) end)
local byDef, byDefLower = {}, {}
local lastVariants = {}
local diffNum = { easy = 1, medium = 2, intermediate = 3, hard = 4, expert = 5, genius = 6, master = 7, insanity = 8, randomizer = 9 }
local defCount = 0
if type(WordDB) == "table" then
    for cat, list in pairs(WordDB) do
        if type(list) == "table" then
            for _, e in ipairs(list) do
                if type(e) == "table" and e.word and e.definition then
                    local variants = {}
                    if type(e.word) == "string" then
                        variants = { e.word }
                    elseif type(e.word) == "table" then
                        for _, v in ipairs(e.word) do
                            if type(v) == "string" and v ~= "" then table.insert(variants, v) end
                        end
                    end
                    if #variants > 0 and not byDef[e.definition] then
                        byDef[e.definition] = { list = variants, c = tostring(cat) }
                        defCount = defCount + 1
                    end
                    local dl = string.lower(e.definition)
                    if #variants > 0 and not byDefLower[dl] then byDefLower[dl] = { list = variants, c = tostring(cat) } end
                end
            end
        end
    end
end

local function screenGui()
    local pg = LocalPlayer:FindFirstChildOfClass("PlayerGui")
    return pg and pg:FindFirstChild("ScreenGui") or nil
end

-- ================= HELPERS =================
local function char() return LocalPlayer.Character end
local function say(m)
