local TabUtil = window:CreateTab({ name = "Utility" })
local TabSafe = window:CreateTab({ name = "Safety" })

-- ================= STATE =================
local autoOn = false
local cps = 7
local burstOn = true
local burstN = 5
local burstPauseCs = 30
local preDelayCs = 30
local submitDelayCs = 30
local typoRate = 5
local jitterOn = true
local typosOn = true
local ghostMode = false
local remoteSubmit = false
local autoRepeat = false
local autoFocus = false
local focusPause = false
local autoSlow = false
local antiAfk = false
local autoCopy = false
local turnActive = false
local typedThisTurn = false
local potato = false
local lastWord = ""
local typing = false
local panicStop = false
local maxLen = 0
local rounds, lettersTotal, typeTimeTotal, bestWpm = 0, 0, 0, 0
local startTime = os.clock()
local history = {}

local log, wordBox, historyBox, typingBox = nil, nil, nil, nil
local roundsStat, lettersStat, bestStat, curWpmStat, uptimeStat = nil, nil, nil, nil, nil
local avgStat, rwStat, diffStat = nil, nil, nil
local cpsInput = nil

local fpsAvg = 60
pcall(function()
    local acc, n = 0, 0
    game:GetService("RunService").RenderStepped:Connect(function(dt)
        acc = acc + dt
        n = n + 1
        if n >= 30 then fpsAvg = n / math.max(acc, 0.001) acc, n = 0, 0 end
    end)
end)

-- ================= GAME BINDINGS (1x1x1 CALAMITY) =================
local Events = RS:WaitForChild("Events")
local TypingEvent = Events:WaitForChild("TypingEvent")
local ReplaySound = Events:WaitForChild("ReplaySoundEvent")

-- Word arrives as a server push (same channel the game's own AutoType uses).
local eventWord, eventWordAt, lastEventSeen = "", 0, 0
local defSeq, typedDefSeq = 0, 0
local function hookWordEvent(ev)
    pcall(function()
        ev.OnClientEvent:Connect(function(...)
            for _, a in ipairs({ ... }) do
                if type(a) == "string" and a ~= "" then
                    eventWord, eventWordAt = a, os.clock()
                    break
                end
            end
        end)
    end)
end
hookWordEvent(Events:FindFirstChild("GetWordForClientEvent"))
hookWordEvent(Events:FindFirstChild("SelectWordEvent"))
-- Definition re-pushes (even identical text) also mark a fresh round.
pcall(function()
    local de = Events:FindFirstChild("DescriptionEvent")
    if de then de.OnClientEvent:Connect(function(a)
        if type(a) == "string" and a ~= "" then defSeq = defSeq + 1 end
    end) end
end)

local function screenMain()
    local pg = LocalPlayer:FindFirstChildOfClass("PlayerGui")
    return pg and pg:FindFirstChild("Main") or nil
end

-- ================= HELPERS =================
local function char() return LocalPlayer.Character end
local function say(m)
    if log then pcall(function() log:Append(m) end) end
end
local function textbox()
    local m = screenMain()
    local sg = m and m:FindFirstChild("SpellingGui")
    local box = sg and sg:FindFirstChild("SpellingBox")
    if box and box:IsA("TextBox") then return box end
    return nil
end
local function paperVisible()
    local box = textbox()
    return box and box.Visible == true
end
local function isMyTurn()
    return paperVisible()
end
local function currentDef()
    local m = screenMain()
    local dg = m and m:FindFirstChild("DescriptionGui")
    local dt = dg and dg:FindFirstChild("DescriptionText")
    local txt = ""
    pcall(function() txt = tostring(dt and dt.Text or "") end)
    return txt
end
local function currentWord()
    if eventWord == "" then return "" end
    return eventWord
end
local function slowMult()
    if autoSlow and fpsAvg < 20 then return 1.6 end
    return 1
end
local function charDelay()
    if cps <= 0 then return 0 end
    local base = 1 / cps * slowMult()
    if not jitterOn then return base end
    local d = base + math.random() * base
    if math.random() < 0.06 then d = d + 0.4 + math.random() * 0.4 end
    return d
end
local function isFocused()
    local f = nil
    pcall(function() f = isrbxactive() end)
    if f == nil then pcall(function() f = isgameactive() end) end
    return f
end
local function syncCps()
    if not cpsInput then return end
    pcall(function()
        local t = tonumber(cpsInput.value)
        if t then cps = math.clamp(math.floor(t), 0, 1000) end
    end)
end
local function mirrorType(txt)
    pcall(function() TypingEvent:FireServer(txt, false) end)
end
local function noteWord(w)
    lastWord = w
    typedThisTurn = true
    typedDefSeq = defSeq
    rounds = rounds + 1
    if roundsStat then pcall(function() roundsStat:Set(rounds) end) end
    if rwStat then pcall(function() rwStat:Set(rounds) end) end
    if wordBox then pcall(function() wordBox:Set(w .. "  (" .. #w .. " letters)") end) end
    table.insert(history, w)
    if #history > 30 then table.remove(history, 1) end
    if historyBox then pcall(function() historyBox:Append(rounds .. ". " .. w) end) end
    if autoCopy and w ~= "" then
        pcall(function()
            if type(setclipboard) == "function" then setclipboard(w) end
        end)
    end
    if autoRepeat then task.spawn(function() repeatAudio() end) end
end
local function logTyping(w, mode, secs)
    if typingBox then pcall(function()
        typingBox:Append(w .. " [" .. mode .. ", " .. string.format("%.1f", secs) .. "s]")
    end) end
    if secs > 0 then
        local wpm = math.floor((#w / math.max(secs, 0.01)) * 12 + 0.5)
        if curWpmStat then pcall(function() curWpmStat:Set(wpm) end) end
        if wpm > bestWpm then
            bestWpm = wpm
            if bestStat then pcall(function() bestStat:Set(bestWpm) end) end
        end
    end
end
function repeatAudio()
    pcall(function() ReplaySound:FireServer() end)
end
local function submitAnswer(box)
    if remoteSubmit or ghostMode then
        local txt = ""
        pcall(function() txt = box and box.Text or currentWord() end)
        pcall(function() TypingEvent:FireServer(txt, true) end)
        say("Submitted via remote (experimental).")
        return
    end
    local f = isFocused()
    if f == false then
        say("Window not focused - press Enter yourself!")
    else
        pcall(function() keyclick(13) end)
    end
end
local function ghostType(word)
    if cps <= 0 then
        -- INSTANT PASTE: one mirror + one submit, zero delays, fresh word
        local fresh = currentWord()
        if fresh ~= "" then word = string.lower(fresh) end
        mirrorType(word)
        pcall(function() TypingEvent:FireServer(word, true) end)
        say("Ghost pasted instantly - check the round result.")
        return
    end
    local i, n = 1, 0
    local frag = ""
    while i <= #word do
        if panicStop then return end
        frag = word:sub(1, i)
        mirrorType(frag)
        i = i + 1
        n = n + 1
        task.wait(charDelay())
        if burstOn and n >= burstN and i <= #word then
            n = 0
            local p = burstPauseCs / 100 * slowMult()
            if jitterOn then p = p + math.random() * (burstPauseCs / 100) end
            task.wait(p)
        end
    end
    task.wait(submitDelayCs / 100)
    pcall(function() TypingEvent:FireServer(frag, true) end)
    say("Ghost submit sent - check the round result.")
end
local function typeWord(word)
    if typing then return end
    syncCps()
    if maxLen > 0 and #word > maxLen then say("Skipped: " .. #word .. " letters over limit.") return end
    if focusPause and isFocused() == false then say("Paused: window not focused.") return end
    typing = true
    panicStop = false
    local t0 = os.clock()
    if ghostMode then
        say("Ghost mode: typing invisibly...")
        ghostType(word)
        typeTimeTotal = typeTimeTotal + (os.clock() - t0)
        lettersTotal = lettersTotal + #word
        if lettersStat then pcall(function() lettersStat:Set(lettersTotal) end) end
        logTyping(word, (cps <= 0 and "ghost-paste" or "ghost"), os.clock() - t0)
        typing = false
        return
    end
    local box = textbox()
    if not box then say("No textbox found.") typing = false return end
    if not paperVisible() then say("SpellingBox hidden - not your turn?") typing = false return end
    pcall(function() box:CaptureFocus() end)
    box.Text = ""
    mirrorType("")
    if cps > 0 then task.wait(preDelayCs / 100) end
    if cps <= 0 then
        -- INSTANT PASTE: fresh word, zero delays
        local fresh = currentWord()
        if fresh ~= "" then word = string.lower(fresh) end
        say("PASTE MODE - ban risk accepted.")
        box.Text = word
        mirrorType(word)
    else
        local i, n = 1, 0
        while i <= #word do
            if panicStop then typing = false return end
            if not isMyTurn() then say("Turn lost mid-type, stopping.") typing = false return end
            if typosOn and i > 1 and i < #word and math.random(100) <= typoRate then
                local ch = word:sub(i, i)
                local wrong = string.char(math.random(97, 122))
                if wrong == ch then wrong = "x" end
                box.Text = word:sub(1, i - 1) .. wrong
                mirrorType(box.Text)
                task.wait(charDelay() + 0.15 + math.random() * 0.3)
                box.Text = word:sub(1, i - 1)
                mirrorType(box.Text)
                task.wait(0.12 + math.random() * 0.2)
            end
            box.Text = word:sub(1, i)
            mirrorType(box.Text)
            i = i + 1
            n = n + 1
            task.wait(charDelay())
            if burstOn and n >= burstN and i <= #word then
                n = 0
                local p = burstPauseCs / 100 * slowMult()
                if jitterOn then p = p + math.random() * (burstPauseCs / 100) end
                task.wait(p)
            end
        end
    end
    lettersTotal = lettersTotal + #word
    if lettersStat then pcall(function() lettersStat:Set(lettersTotal) end) end
    typeTimeTotal = typeTimeTotal + (os.clock() - t0)
    logTyping(word, (cps <= 0 and "paste" or ("visual@" .. cps .. "cps")), os.clock() - t0)
    if cps > 0 then task.wait(submitDelayCs / 100) end
    submitAnswer(box)
    typing = false
end

