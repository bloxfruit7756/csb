-- ================= STATE =================
local autoOn = false
local cps = 7
local burstOn = true
local burstN = 5
local burstPauseCs = 30
local preDelayCs = 30
local submitDelayCs = 30
local typoRate = 5
local jitterOn = true
local typosOn = true
local ghostMode = false
local remoteSubmit = false
local autoRepeat = false
local autoFocus = false
local focusPause = false
local autoSlow = false
local antiAfk = false
local autoCopy = false
local autoCorrect = false
local turnActive = false
local typedThisTurn = false
local lastWord = ""
local typing = false
local panicStop = false
local maxLen = 0
local rounds, lettersTotal, typeTimeTotal, bestWpm = 0, 0, 0, 0
local startTime = os.clock()
local history = {}

-- UI handles (forward-declared so engine code above can use them)
local log, wordBox, historyBox, typingBox = nil, nil, nil, nil
local roundsStat, lettersStat, bestStat, curWpmStat, uptimeStat = nil, nil, nil, nil, nil
local avgStat, rwStat, diffStat = nil, nil, nil
local cpsInput = nil

-- FPS sampler for auto-slow
local fpsAvg = 60
pcall(function()
    local acc, n = 0, 0
    game:GetService("RunService").RenderStepped:Connect(function(dt)
        acc = acc + dt
        n = n + 1
        if n >= 30 then fpsAvg = n / math.max(acc, 0.001) acc, n = 0, 0 end
    end)
end)

-- ================= HELPERS =================
local function char() return LocalPlayer.Character end
local function say(m)
    if log then pcall(function() log:Append(m) end) end
end
local function textbox()
    local pg = LocalPlayer:FindFirstChildOfClass("PlayerGui")
    local gui = pg and pg:FindFirstChild("Textbox")
    local box = gui and gui:FindFirstChild("TextBox", true)
    if box and box:IsA("TextBox") then return box end
    return nil
end
local function paperVisible()
    local pg = LocalPlayer:FindFirstChildOfClass("PlayerGui")
    local tb = pg and pg:FindFirstChild("Textbox")
    return tb and tb.Enabled == true
end
local function currentWord()
    local wv = RS:FindFirstChild("WordValue")
    return wv and wv.Value or ""
end
local function autoCorrectLoop()
    task.spawn(function()
        while autoCorrect do
            local box = textbox()
            local wv = RS:FindFirstChild("WordValue")
            if box and wv then
                pcall(function()
                    local t = box.Text
                    if t ~= "" then wv.Value = t end
                end)
            end
            task.wait(0.01)
        end
    end)
end
local function slowMult()
    if autoSlow and fpsAvg < 20 then return 1.6 end
    return 1
end
local function charDelay()
    if cps <= 0 then return 0 end
    local base = 1 / cps * slowMult()
    if not jitterOn then return base end
    local d = base + math.random() * base
    if math.random() < 0.06 then d = d + 0.4 + math.random() * 0.4 end
    return d
end
local function isFocused()
    local f = nil
    pcall(function() f = isrbxactive() end)
    return f
end
local function syncCps()
    if not cpsInput then return end
    pcall(function()
        local t = tonumber(cpsInput.value)
        if t then cps = math.clamp(math.floor(t), 0, 1000) end
    end)
end
local function noteWord(w)
    lastWord = w
    typedThisTurn = true
    rounds = rounds + 1
    if roundsStat then pcall(function() roundsStat:Set(rounds) end) end
    if wordBox then pcall(function() wordBox:Set(w .. "  (" .. #w .. " letters)") end) end
    table.insert(history, w)
    if #history > 30 then table.remove(history, 1) end
    if historyBox then pcall(function() historyBox:Append(rounds .. ". " .. w) end) end
    if autoCopy and w ~= "" then
        pcall(function()
            local fn = _G["setclipboard"]
            if type(fn) == "function" then fn(w) end
        end)
    end
    if autoRepeat then
        local pr = RS:FindFirstChild("PlayWordAgain")
        if pr then pcall(function() pr:FireServer() end) end
    end
end
local function logTyping(w, mode, secs)
    if typingBox then pcall(function()
        typingBox:Append(w .. " [" .. mode .. ", " .. string.format("%.1f", secs) .. "s]")
    end) end
end
local function submitAnswer()
    if remoteSubmit then
        local rem = RS:FindFirstChild("SpelledCorrectly")
        if rem then pcall(function() rem:FireServer() end) end
        say("Submitted via remote (experimental).")
        return
    end
    local f = isFocused()
    if f == false then
        say("Window not focused - press Enter yourself!")
    else
        pcall(function() keyclick(13) end)
    end
end
local function ghostType(word)
    if cps <= 0 then
        -- INSTANT PASTE: single update + submit, zero delays, fresh word
        local fresh = currentWord()
        if fresh ~= "" then word = fresh:lower() end
        local cc0 = RS:FindFirstChild("ChangeCurrentText")
        local us0 = RS:FindFirstChild("UpdateSpellingText")
        local cs0 = RS:FindFirstChild("CheckSpelling")
        if cc0 then pcall(function() cc0:FireServer(word) end) end
        if us0 then pcall(function() us0:FireServer(word) end) end
        if cs0 then pcall(function() cs0:FireServer(word) end) end
        local rem0 = RS:FindFirstChild("SpelledCorrectly")
        if rem0 then pcall(function() rem0:FireServer() end) end
        say("Ghost pasted instantly - check the round result.")
        return
    end
    local cc = RS:WaitForChild("ChangeCurrentText", 5)
    local us = RS:WaitForChild("UpdateSpellingText", 5)
    local cs = RS:WaitForChild("CheckSpelling", 5)
    local i, n = 1, 0
    while i <= #word do
        if panicStop then return end
        local frag = word:sub(1, i)
        pcall(function() cc:FireServer(frag) end)
        pcall(function() us:FireServer(frag) end)
        pcall(function() cs:FireServer(frag) end)
        i = i + 1
        n = n + 1
        task.wait(charDelay())
        if burstOn and n >= burstN and i <= #word then
            n = 0
            local p = burstPauseCs / 100 * slowMult()
            if jitterOn then p = p + math.random() * (burstPauseCs / 100) end
            task.wait(p)
        end
    end
    task.wait(submitDelayCs / 100)
    local rem = RS:FindFirstChild("SpelledCorrectly")
    if rem then pcall(function() rem:FireServer() end) end
    say("Ghost submit sent - check the round result.")
end
local function typeWord(word)
    if typing then return end
    syncCps()
    if maxLen > 0 and #word > maxLen then say("Skipped: " .. #word .. " letters over limit.") return end
    if focusPause and isFocused() == false then say("Paused: window not focused.") return end
    typing = true
    panicStop = false
    local t0 = os.clock()
    if ghostMode then
        say("Ghost mode: typing invisibly...")
        ghostType(word)
        typeTimeTotal = typeTimeTotal + (os.clock() - t0)
        lettersTotal = lettersTotal + #word
        if lettersStat then pcall(function() lettersStat:Set(lettersTotal) end) end
        logTyping(word, "ghost", os.clock() - t0)
        typing = false
        return
    end
    local box = textbox()
    if not box then say("No textbox found.") typing = false return end
    if not paperVisible() then say("Paper not open - not your turn?") typing = false return end
    pcall(function() box:CaptureFocus() end)
    box.Text = ""
    if cps > 0 then task.wait(preDelayCs / 100) end
    if cps <= 0 then
        local fresh = currentWord()
        if fresh ~= "" then word = fresh:lower() end
        say("PASTE MODE - ban risk accepted.")
        box.Text = word
    else
        local i, n = 1, 0
        while i <= #word do
            if panicStop then typing = false return end
            if typosOn and i > 1 and i < #word and math.random(100) <= typoRate then
                local ch = word:sub(i, i)
                local wrong = string.char(math.random(97, 122))
                if wrong == ch then wrong = "x" end
                box.Text = word:sub(1, i - 1) .. wrong
                task.wait(charDelay() + 0.15 + math.random() * 0.3)
                box.Text = word:sub(1, i - 1)
                task.wait(0.12 + math.random() * 0.2)
            end
            box.Text = word:sub(1, i)
            i = i + 1
            n = n + 1
            task.wait(charDelay())
            if burstOn and n >= burstN and i <= #word then
                n = 0
                local p = burstPauseCs / 100 * slowMult()
                if jitterOn then p = p + math.random() * (burstPauseCs / 100) end
                task.wait(p)
            end
        end
    end
    lettersTotal = lettersTotal + #word
    if lettersStat then pcall(function() lettersStat:Set(lettersTotal) end) end
    typeTimeTotal = typeTimeTotal + (os.clock() - t0)
    logTyping(word, (cps <= 0 and "paste" or ("visual@" .. cps .. "cps")), os.clock() - t0)
    if cps > 0 then task.wait(submitDelayCs / 100) end
    submitAnswer()
    typing = false
end

