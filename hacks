    calamity = [[-- 1x1x1's Spelling Bee AutoTyper -- Rayfield Gen2 edition (1x1x1's Spelling Bee [CALAMITY])
-- Word = GetWordForClientEvent/SelectWordEvent push (cached) | Box = Main.SpellingGui.SpellingBox | Turn = box Visible
-- Mirror = TypingEvent(text,false) | Submit = TypingEvent(text,true) or game's Enter | Repeat = ReplaySoundEvent

local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")
local LocalPlayer = Players.LocalPlayer

local Rayfield = loadstring(game:HttpGet("https://sirius.menu/gen2"))()

