-- SpeakWord / AnnounceWordEvent / RepeatWordAudioEvent all carry the
-- word as arg 1 (it gets played as audio). Hook all three.
local function watchWord(remoteName)
    local rem = RS:FindFirstChild(remoteName)
    if rem then
        pcall(function()
            (rem :: any).OnClientEvent:Connect(function(word)
                if type(word) == "string" and #word >= 1 then
                    noteWord(word, remoteName)
                    if autoShowAnswer then
                        say("Answer: " .. word)
                        window:Notify({ title = "Word", content = word:sub(1, 60) })
                    end
                end
            end)
        end)
    end
end
